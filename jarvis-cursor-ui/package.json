{
  "name": "cortana-cursor-ui",
  "displayName": "CORTANA Command Center UI",
  "description": "Full CORTANA Command Center HUD for Cursor via Custom CSS workbench injection: suit modes, particles, GitHUD, threat hints, Session Cinema, Focus Fortress, Stream Pack, Voice TTS hooks, and File Map. Inspired by cortana.institute + Cortana 3D PRO patterns — custom local reimplementation, all features unlocked.",
  "version": "0.5.4",
  "publisher": "ps2recomp-local",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Themes",
    "Other"
  ],
  "keywords": [
    "cortana",
    "command center",
    "hud",
    "iron man",
    "suit modes",
    "cyan",
    "dark",
    "file map",
    "theme",
    "custom css",
    "injection"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./src/extension.js",
  "contributes": {
    "configurationDefaults": {
      "window.titleBarStyle": "custom",
      "workbench.sideBar.location": "left",
      "workbench.activityBar.location": "default"
    },
    "themes": [
      {
        "label": "CORTANA Command",
        "uiTheme": "vs-dark",
        "path": "./themes/cortana-command-color-theme.json"
      },
      {
        "label": "CORTANA Mark I",
        "uiTheme": "vs-dark",
        "path": "./themes/cortana-mark1-color-theme.json"
      },
      {
        "label": "CORTANA Mark 50",
        "uiTheme": "vs-dark",
        "path": "./themes/cortana-mark50-color-theme.json"
      },
      {
        "label": "CORTANA Endgame",
        "uiTheme": "vs-dark",
        "path": "./themes/cortana-endgame-color-theme.json"
      },
      {
        "label": "CORTANA Stealth",
        "uiTheme": "vs-dark",
        "path": "./themes/cortana-stealth-color-theme.json"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cortanaCommand",
          "title": "CORTANA",
          "icon": "media/cortana-activity.svg"
        }
      ]
    },
    "views": {
      "cortanaCommand": [
        {
          "type": "webview",
          "id": "cortana.commandCenter",
          "name": "Command Center",
          "icon": "media/cortana-activity.svg"
        },
        {
          "type": "webview",
          "id": "cortana.fileMap",
          "name": "File Map",
          "icon": "media/cortana-activity.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "cortana.fileMap.refresh",
        "title": "CORTANA: Refresh File Map",
        "icon": "$(refresh)"
      },
      {
        "command": "cortana.fileMap.focus",
        "title": "CORTANA: Focus File Map"
      },
      {
        "command": "cortana.commandCenter.focus",
        "title": "CORTANA: Focus Command Center"
      },
      {
        "command": "cortana.theme.applyHints",
        "title": "CORTANA: Apply Active Suit Theme"
      },
      {
        "command": "cortana.suit.pick",
        "title": "CORTANA: Suit Mode…"
      },
      {
        "command": "cortana.voice.talk",
        "title": "CORTANA: Talk / Start Voice"
      },
      {
        "command": "cortana.voice.talk",
        "title": "CORTANA: Talk / Start Voice"
      },
      {
        "command": "cortana.voice.chat",
        "title": "CORTANA: Open Chat"
      },
      {
        "command": "cortana.voice.wakeListen",
        "title": "CORTANA: Wake Listen / Hey Cortana"
      },
      {
        "command": "cortana.toggle.focusFortress",
        "title": "CORTANA: Toggle Focus Fortress"
      },
      {
        "command": "cortana.toggle.cinema",
        "title": "CORTANA: Toggle Session Cinema"
      },
      {
        "command": "cortana.toggle.streamPack",
        "title": "CORTANA: Toggle Stream Pack"
      },
      {
        "command": "cortana.toggle.friday",
        "title": "CORTANA: Toggle F.R.I.D.A.Y. Mode"
      },
      {
        "command": "cortana.preset.save",
        "title": "CORTANA: Save Workspace Preset"
      },
      {
        "command": "cortana.preset.apply",
        "title": "CORTANA: Apply Workspace Preset"
      },
      {
        "command": "cortana.hud.refresh",
        "title": "CORTANA: Refresh HUD"
      },
      {
        "command": "cortana.injection.enable",
        "title": "CORTANA: Enable Workbench Injection"
      },
      {
        "command": "cortana.injection.enable",
        "title": "CORTANA: Enable Workbench Injection"
      },
      {
        "command": "cortana.injection.disable",
        "title": "CORTANA: Disable Workbench Injection"
      },
      {
        "command": "cortana.injection.reenableAfterUpdate",
        "title": "CORTANA: Re-enable Injection After Update"
      },
      {
        "command": "cortana.injection.healthCheck",
        "title": "CORTANA: Injection Health Check"
      },
      {
        "command": "cortana.injection.status",
        "title": "CORTANA: Injection Status"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "cortana.fileMap.refresh",
          "when": "view == cortana.fileMap || view == cortana.commandCenter",
          "group": "navigation"
        }
      ],
      "commandPalette": [
        {
          "command": "cortana.suit.pick"
        },
        {
          "command": "cortana.voice.talk"
        },
        {
          "command": "cortana.voice.wakeListen"
        },
        {
          "command": "cortana.preset.save"
        },
        {
          "command": "cortana.preset.apply"
        },
        {
          "command": "cortana.injection.enable"
        },
        {
          "command": "cortana.injection.enable"
        },
        {
          "command": "cortana.voice.talk"
        },
        {
          "command": "cortana.injection.disable"
        },
        {
          "command": "cortana.injection.reenableAfterUpdate"
        },
        {
          "command": "cortana.injection.healthCheck"
        },
        {
          "command": "cortana.injection.status"
        }
      ]
    },
    "configuration": {
      "title": "CORTANA Command Center",
      "properties": {
        "cortana.fileMap.maxEntries": {
          "type": "number",
          "default": 4000,
          "minimum": 200,
          "maximum": 20000,
          "description": "Max files/folders to scan into the File Map."
        },
        "cortana.fileMap.ignore": {
          "type": "array",
          "default": [
            ".git",
            "node_modules",
            ".next",
            "dist",
            "out",
            "build",
            ".cursor",
            "agent-transcripts",
            "terminals"
          ],
          "items": {
            "type": "string"
          },
          "description": "Directory names skipped while building the File Map."
        },
        "cortana.hud.glowDefault": {
          "type": "number",
          "default": 1,
          "minimum": 0.4,
          "maximum": 2,
          "description": "Default glow intensity for HUD FX."
        },
        "cortana.injection.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Custom CSS workbench injection (primary HUD). Requires Admin once to write under Program Files."
        },
        "cortana.injection.bootMs": {
          "type": "number",
          "default": 1200,
          "minimum": 0,
          "maximum": 10000,
          "description": "Boot / calibrating splash duration in milliseconds before injected chrome settles."
        },
        "cortana.injection.fallbackWebview": {
          "type": "boolean",
          "default": false,
          "description": "When false and injection is active, Command Center webview is demoted (injection is primary). When true, keep webview as optional fallback HUD."
        }
      }
    }
  }
}
